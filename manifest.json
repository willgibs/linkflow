{
  "manifest_version": 3,
  "name": "Linkflow",
  "version": "2.2.0",
  "description": "Instantly analyze all links on a webpage, scan for empty links, and identify unique links.",
  "author": "Will Gibson",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_icon": "assets/icons/icon.png",
    "default_popup": "popup.html",
    "default_title": "Linkflow"
  },
  "icons": {
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
